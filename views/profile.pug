extends layout.pug

block content
  include navbar.pug

  .container.my-5
    
    .row.mb-5
      .col-12.col-md-10.mx-auto
        .card.shadow-sm.border-0.p-4.bg-dark.text-white(style="border-radius: 16px;")
          .d-flex.flex-column.flex-sm-row.align-items-center.justify-content-between.gap-3
            
            //- Sección Izquierda: Avatar e Información básica
            .d-flex.align-items-center.flex-column.flex-sm-row.text-center.text-sm-start
              .bg-warning.text-dark.rounded-circle.d-flex.align-items-center.justify-content-center.mb-3.mb-sm-0.me-sm-4(style="width: 75px; height: 75px; min-width: 75px;")
                i.bi.bi-person-fill.fs-1
              div
                h2.fw-bold.mb-1 @#{perfilUser.username}
                p.text-white-50.small.mb-0
                  i.bi.bi-patch-check-fill.text-warning.me-1
                  | Miembro de la comunidad Fotaza

                if esMiPerfil
                  .mt-3.d-flex.flex-wrap.gap-2.justify-content-center.justify-content-sm-start
                    a.btn.btn-sm.btn-outline-warning.fw-bold.px-3(href="/collections" style="border-radius: 20px;")
                      i.bi.bi-bookmark-heart.me-1
                      | Mis Colecciones 
                    a.btn.btn-sm.btn-outline-warning.fw-bold.px-3(href="/mensajes" style="border-radius: 20px;")
                      i.bi.bi-chat-dots-fill.me-1
                      | Mis Mensajes 
                
                //- BOTON DE SEGUIMIENTO 
                if !esMiPerfil && user
                  .mt-2
                    if yaLoSigo
                      form(action="/follow/dejarDeSeguir" method="POST")
                        input(type="hidden" name="followingId" value=perfilUser.id)
                        button.btn.btn-sm.btn-outline-danger.fw-bold.px-3(type="submit" style="border-radius: 20px;")
                          i.bi.bi-person-dash-fill.me-1
                          | Dejar de seguir
                    else
                      form(action="/follow"  method="POST")
                        input(type="hidden" name="followingId" value=perfilUser.id)
                        button.btn.btn-sm.btn-warning.text-dark.fw-bold.px-3(type="submit" style="border-radius: 20px;")
                          i.bi.bi-person-plus-fill.me-1
                          | Seguir

            //- Sección Derecha: Contadores Estadísticos alineados
            .d-flex.gap-4.bg-secondary.bg-opacity-25.px-4.py-2.rounded-pill
              .text-center
                span.fw-bold.fs-4.d-block.text-warning= contadorSeguidores
                small.text-white-50.text-uppercase.fw-semibold(style="font-size: 0.75rem;") seguidores
              .border-start.border-secondary
              .text-center
                span.fw-bold.fs-4.d-block.text-warning= contadorSeguidos
                small.text-white-50.text-uppercase.fw-semibold(style="font-size: 0.75rem;") seguidos

    //- SECCIÓN DE GALERÍA DE IMÁGENES
    .row
      .col-12.col-md-10.mx-auto

        if perfilUser.Posts && perfilUser.Posts.length > 0
          .row.justify-content-center
            each post in perfilUser.Posts
              .col-12.col-lg-10.mb-4
                .card.shadow-sm.border-0(style="border-radius: 16px; overflow: hidden;")
                  if post.Images && post.Images.length > 0
                    //- Carrusel de Bootstrap
                    div.carousel.slide(id=`carousel-${post.id}` data-bs-ride="false")
                      
                      //- Indicadores inferiores (puntitos) si hay más de una foto
                      if post.Images.length > 1
                        div.carousel-indicators
                          each img, index in post.Images
                            button(type="button" data-bs-target=`#carousel-${post.id}` data-bs-slide-to=index class=(index === 0 ? 'active' : '') aria-current=(index === 0 ? 'true' : 'false'))

                      //- Contenedor de las imágenes del carrusel
                      div.carousel-inner
                        each img, index in post.Images
                          div.carousel-item(class=(index === 0 ? 'active' : ''))
                            img.d-block.w-100(
                              src=img.srcBase64 
                              alt=post.title 
                              style="height: 500px; object-fit: cover;"
                            )
                      
                      //- Flechitas de atrás-adelante
                      if post.Images.length > 1
                        button.carousel-control-prev(type="button" data-bs-target=`#carousel-${post.id}` data-bs-slide="prev")
                          span.carousel-control-prev-icon(aria-hidden="true")
                          span.visually-hidden Anterior
                        button.carousel-control-next(type="button" data-bs-target=`#carousel-${post.id}` data-bs-slide="next")
                          span.carousel-control-next-icon(aria-hidden="true")
                          span.visually-hidden Siguiente
                  else
                    .bg-secondary.text-white.d-flex.align-items-center.justify-content-center(style="height: 220px;")
                      i.bi.bi-camera.fs-1

                  include barraPost.pug  

                  //- Datos de la publicacion
                  .card-body.p-3
                    .d-flex.justify-content-between.align-items-start
                      div
                        h5.card-title.fw-bold.text-dark.mb-1 #{post.title}
                        p.card-text.text-muted.small.mb-0 #{post.description}

                        //- seccion de etiquetas
                        if post.Tags && post.Tags.length > 0
                          .mt-2.d-flex.flex-wrap.gap-1
                            each tag in post.Tags
                              span.badge.rounded-pill.bg-light.text-dark.border.shadow-sm.px-2.py-1(style="font-size: 0.75rem;")
                                | ##{tag.name}
                      
                      //- seccio de estrellas
                      if post.Images && post.Images.length > 0
                        - let image = post.Images[0] 
                        .text-end
                          include ratingStars.pug

                  //- Insignia de tipo de licencia
                  .card-footer.bg-transparent.border-0.p-3.pt-0
                    if post.Images && post.Images[0]
                      span.badge.px-2.py-1.fw-semibold(class=post.Images[0].licencia === 'sinCopyright' ? 'bg-success' : 'bg-danger')
                        | #{post.Images[0].licencia === 'sinCopyright' ? 'Pública' : 'Protegida'}
                    include comment.pug
        else
          .text-center.py-5.bg-white.rounded.shadow-sm.border
            i.bi.bi-images.text-muted.display-4
            p.text-muted.mt-2 Este usuario todavía no ha compartido ninguna foto.