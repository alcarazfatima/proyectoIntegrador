extends layout.pug

block content
  include navbar.pug

  .container.my-4
    .row.justify-content-center
      .col-12.col-md-8
        .card.shadow-sm.rounded-4.border-0
          //- encabezado del chat con el usuario
          .card-header.bg-white.border-bottom.p-3.d-flex.align-items-center.justify-content-between
            .d-flex.align-items-center.gap-2
              i.bi.bi-person-circle.fs-3.text-secondary
              h5.mb-0.fw-bold @#{otroUsuario.username}
            a.btn.btn-outline-secondary.btn-sm.rounded-pill(href="/notifications")
              i.bi.bi-arrow-left.me-1
              | Volver

          //- globos de mensajes
          .card-body.p-3(style="height: 400px; overflow-y: auto;" id="contenedorMensajes")
            if mensajes && mensajes.length > 0
              each msg in mensajes
                //- si el mensaje lo envie yo a la derecha (azul)
                //- si lo recibi a la izquierda (gris)
                if msg.emisorId === user.id
                  .d-flex.justify-content-end.mb-3
                    .bg-primary.text-white.p-3.rounded-4.shadow-sm(style="max-width: 75%;")
                      p.mb-1.fs-6= msg.contenido
                      small.text-white-50.d-block.text-end(style="font-size: 0.75rem;")
                        | #{new Date(msg.createdAt).toLocaleTimeString('es-AR', {hour: '2-digit', minute:'2-digit'})}
                else
                  .d-flex.justify-content-start.mb-3
                    .bg-light.text-dark.p-3.rounded-4.shadow-sm.border(style="max-width: 75%;")
                      p.mb-1.fs-6= msg.contenido
                      small.text-muted.d-block(style="font-size: 0.75rem;")
                        | #{new Date(msg.createdAt).toLocaleTimeString('es-AR', {hour: '2-digit', minute:'2-digit'})}
            else
              .text-center.text-muted.py-5
                i.bi.bi-chat-dots.display-4
                p.mt-2 No hay mensajes en esta conversación.

          //- formu para enviar respuesta
          .card-footer.bg-white.border-top.p-3
            form(action="/mensajes/enviar" method="POST" class="d-flex gap-2")
              input(type="hidden" name="receptorId" value=otroUsuario.id)
              input.form-control.rounded-pill(
                type="text" 
                name="contenido" 
                placeholder="Escribí un mensaje..." 
                required
              )
              button.btn.btn-primary.rounded-circle.px-3(type="submit")
                i.bi.bi-send-fill