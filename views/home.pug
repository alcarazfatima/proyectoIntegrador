extends layout.pug

block content
  include navbar.pug
  //- Contenido del home
  .container.my-5
    .text-center.mb-5
      if user
        h2.fw-bold Bienvenido de nuevo, #{user.username}
      else
        h2.fw-bold.text-dark Explora las mejores fotos de nuestra comunidad
        p.text-muted Registrate para puntuar el contenido.

    .row.row-cols-1.justify-content-center.g-5
      if posts && posts.length > 0
        each post in posts
          .col.col-md-9.col-lg-7
            .card.shadow-sm.border-0.mb-4
              
              if post.Images && post.Images.length > 0
                
                //- CASO 1: TIENE UNA SOLA IMAGEN
                if post.Images.length === 1
                  if post.Images[0].srcBase64
                    img.w-100(
                      src=post.Images[0].srcBase64 
                      alt=post.title 
                      style="height: 550px; object-fit: cover; background-color: #f8f9fa;"
                    )
                
                //- CASO 2: TIENE VARIAS IMÁGENES
                else
                  .row.g-1.m-0
                    each img in post.Images
                      if img.srcBase64
                        .col-6
                          img.w-100(
                            src=img.srcBase64 
                            alt=post.title 
                            style="height: 240px; object-fit: cover; background-color: #f8f9fa;"
                          )
                          
              else
                .bg-secondary.text-white.text-center.py-5(style="height: 350px; display: flex; align-items: center; justify-content: center;") Sin Imagen
              
              .card-body.p-4
                //- Cabecera con el autor y botón Seguir
                if post.User
                  .d-flex.justify-content-between.align-items-center.mb-3.pb-2.border-bottom
                    .d-flex.align-items-center
                      .bg-warning.text-dark.rounded-circle.d-flex.align-items-center.justify-content-center.me-2(style="width: 32px; height: 32px;")
                        i.bi.bi-person-fill
                      a.fw-bold.text-dark.text-decoration-none(href=`/profile/${post.User.username}`) @#{post.User.username}
                    
                    //- Si estás registrada y la foto NO es tuya, podés seguirlo
                    if user && user.id !== post.userId
                      if misSeguidos && misSeguidos.includes(post.userId)
                        span.badge.bg-light.text-muted.border.fw-semibold 
                          i.bi.bi-check2.me-1
                          | Siguiendo
                      else    
                        form(action="/follow" method="POST" class="m-0")
                          input(type="hidden" name="followingId" value=post.userId)
                          button.btn.btn-sm.btn-outline-primary.fw-semibold(type="submit")
                            i.bi.bi-person-plus-fill.me-1
                            | Seguir

                h4.card-title.fw-bold.text-dark.mb-2= post.title
                p.card-text.text-muted.fs-5= post.description
            
                hr.text-muted.my-3
                .d-flex.justify-content-between.align-items-center
                  //- seccin de las estrellas
                  if post.Images && post.Images.length > 0
                    - let image = post.Images[0]
                    include ratingStars.pug
                  else
                    span.text-muted.small Sin calificaciones
                    
                  small.text-muted.fw-medium Estado: #{post.status}
                
                include comment.pug
      else
        .col.col-md-9.col-lg-7.text-center.py-5
          .alert.alert-info No hay publicaciones disponibles en este momento.