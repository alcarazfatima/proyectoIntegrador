extends ../layout.pug 

block metadata
    title Registrarse
    link(rel="stylesheet" href="/style.css")

block content
    div
      div
        h1 Registrarse
        form(method='POST', action='/auth/signup')
          div
            label(for='firstName') Nombre
            input(type='text', id='firstName', name='firstName', required)
          div
            label(for='lastName') Apellido
            input(type='text', id='lastName', name='lastName', required)  
          div
            label(for='birthDate') Fecha de nacimiento
            input(type='date', id='birthDate', name='birthDate', required)
          div
            label(for='email') Email
            input(type='email', id='email', name='email', required)
          div
            label(for='rol') Tipo de cuenta
            select(name='rol', id= 'rol')
              option(value='usuario') Usuario
              option(value='validador') Validador
          div
            label(for='password') Contraseña
            input(type='password', id='password', name='password', required)
          
          div
            label(for='confirmPassword') Confirmar Contraseña
            input(type='password', id='confirmPassword', name='confirmPassword', required)
          div
            button(type='submit') Registrarse
          
          p
            | ¿Ya tienes cuenta? 
            a(href='/auth/login') Inicia sesión aquí
